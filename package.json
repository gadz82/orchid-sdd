{
  "name": "orchid-sdd",
  "version": "1.0.0",
  "description": "A memory-backed, specification-driven development (SDD) skill for coding agents.",
  "type": "module",
  "bin": {
    "orchid-sdd": "./bin/orchid-sdd.mjs"
  },
  "files": [
    "bin",
    "cli",
    "commands",
    "claude-commands",
    "claude-skills",
    ".claude-plugin",
    "SKILL.md",
    "skills.sh.json",
    "README.md",
    ".skill",
    "docs/orchid-sdd-design.md",
    "docs/personas"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/setup.test.mjs tests/memory.test.mjs tests/lifecycle.test.mjs tests/workspace.test.mjs tests/migration.test.mjs tests/plugin.test.mjs tests/personas.test.mjs tests/skill-install.test.mjs tests/profiles.test.mjs tests/steering.test.mjs tests/models.test.mjs tests/prompt-state.test.mjs tests/dependencies.test.mjs tests/recall-dependencies.test.mjs tests/recall-index.test.mjs tests/recall-versioning.test.mjs tests/prompt-validate.test.mjs tests/doctor-quality.test.mjs",
    "prepublishOnly": "npm test",
    "plugin:check": "node --test tests/plugin.test.mjs",
    "personas:check": "node --test tests/personas.test.mjs",
    "skill:check": "node --test tests/skill-install.test.mjs",
    "profiles:check": "node --test tests/profiles.test.mjs",
    "steering:check": "node --test tests/steering.test.mjs",
    "models:check": "node --test tests/models.test.mjs",
    "prompt-state:check": "node --test tests/prompt-state.test.mjs"
  },
  "keywords": [
    "sdd",
    "spec-driven",
    "coding-agent",
    "opencode",
    "claude-code",
    "skills",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gadz82/orchid-sdd.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "semantic-release": "^25.0.9"
  }
}
