{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchid.dev/spec/schemas/prompt.json",
  "title": "orchid-sdd prompt front matter",
  "type": "object",
  "required": ["id", "type", "title", "wave", "personas", "scope", "acceptance"],
  "additionalProperties": false,
  "properties": {
    "id": { "pattern": "^P-[0-9]{3}$" },
    "type": { "enum": ["build", "test", "spike"] },
    "title": { "type": "string" },
    "repo": { "type": "string" },
    "wave": { "type": "integer", "minimum": 1 },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "personas": { "type": "array", "items": { "type": "string" } },
    "scope": {
      "type": "object",
      "required": ["write"],
      "properties": {
        "write": { "type": "array", "items": { "type": "string" } },
        "read": { "type": "array", "items": { "type": "string" } }
      }
    },
    "deliverables": { "type": "object" },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "memory_refs": { "type": "array", "items": { "type": "string" } },
    "constitution_refs": { "type": "array", "items": { "type": "string" } },
    "estimate": { "enum": ["S", "M", "L"] },
    "timebox": { "type": "string" }
  }
}
